        Chua dang ky
    }
    class HUIMAlgorithm {
        <<abstract>>
        Chua dang ky
    }
    class IPSEvaluator {
        +evaluate(truth, prediction, task)
    }
    class ReportExporter {
        +export(result, splits, directory)
    }
    class RunResult {
        +predictions: dict
        +metrics: dict
        +matrices: dict
        +runtime: dict
