classDiagram
    direction TB
    class ExperimentRunner {
        +run(config) RunResult
    }
    class ExperimentConfig {
        +algorithm_id: str
        +params: dict
        +split_dir: Path
        +output_dir: Path
    }
    class DatasetRepository {
        +load(directory) Bundle
    }
    class AlgorithmFactory {
        +register(id, concrete_class)
        +create(id, config) Algorithm
    }
    class Algorithm {
        <<abstract>>
        +prepare(train)
        +execute(validation) AlgorithmExecution
        +predict(inputs) IPSPredictions
        +get_diagram() optional
    }
    class KANMixerAlgorithm {
        efficient-kan B-spline
    }
    class LLMAlgorithm {
        <<abstract>>
        Chua dang ky
    }
    class HUIMAlgorithm {
        <<abstract>>
        Chua dang ky
    }
    class IPSEvaluator
    class ReportExporter
    class RunResult {
        +predictions: dict
        +metrics: dict
        +matrices: dict
        +runtime: dict
        +history: optional
        +resources: optional
        +diagram: optional
    }
