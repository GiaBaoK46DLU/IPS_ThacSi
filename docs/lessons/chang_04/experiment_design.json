    "channels": 64,
    "blocks": 2,
    "token_hidden": 32,
    "channel_hidden": 128,
    "dropout_after_each_branch_layer": 0.1,
    "pre_layernorm": true,
    "residual_connections": true,
    "final_layernorm": true,
    "pooling": "mean_tokens",
    "mlp_mixer_activation": "GELU_between_linears",
